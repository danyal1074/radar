# ── Supabase (production). Leave empty to run in local DEV mode (JSON file store, sample data). ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
# At least 32 random chars (used to sign dev-mode sessions)
SESSION_SECRET=
# Emails (comma separated) that become platform admins when they register
ADMIN_EMAILS=
# Secret for the scheduler: GET /api/cron/pipeline with "Authorization: Bearer <CRON_SECRET>" (min 16 chars)
CRON_SECRET=

# ── Billing (manual card-to-card; an admin confirms each payment) ──
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
SUPPORT_CONTACT=

# ── Price estimation (Baravard) — client NOT implemented yet, see README ──
BARAVARD_API_KEY=
ESTIMATE_TTL_HOURS=24
ESTIMATE_FAILURE_RETRY_MINUTES=60
MAX_ESTIMATES_PER_RUN=50
MAX_ESTIMATES_PER_DAY=500
ESTIMATE_COST_TOMAN=0

# ── Safety switches ──
# Demo listings / demo estimates outside dev mode. NEVER true for real customers.
ALLOW_SAMPLE_DATA=false
# Lets the file-based dev store run with NODE_ENV=production. Demo only.
ALLOW_DEV_STORE_IN_PRODUCTION=false
DEV_STORE_PATH=.data/dev-store.json
